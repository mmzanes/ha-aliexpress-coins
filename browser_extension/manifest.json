{
  "manifest_version": 3,
  "name": "AliExpress Coins login sync",
  "version": "0.7.0",
  "description": "Sends your AliExpress login cookies to the AliExpress Coins Home Assistant add-on whenever you log in.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["*://*.aliexpress.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "AliExpress Coins: sync login now" }
}
